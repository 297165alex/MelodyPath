# 后端监听与 SQLite
MELODYPATH_BIND=127.0.0.1:3000
MELODYPATH_DB_PATH=melody_path.db
RUST_LOG=melody_path_api=info,tower_http=info

# 单域名部署（生产环境建议由反向代理提供 HTTPS，并把 /api 转发到 Rust）。
# 设置 PUBLIC_BASE_URL 后，未显式设置的 OAuth 回调会自动派生为：
#   {PUBLIC_BASE_URL}/api/spotify/callback
#   {PUBLIC_BASE_URL}/api/youtube/callback
PUBLIC_BASE_URL=
API_BASE_URL=http://127.0.0.1:3000
VITE_API_PROXY_TARGET=http://127.0.0.1:3000
OAUTH_COOKIE_SECURE=false
# 本地 Windows 使用 DPAPI。生产 Linux 使用 server_encrypted，密钥仅由平台 Secret 注入。
OAUTH_TOKEN_STORE=windows_dpapi
MELODYPATH_ENV=development
# 生产必须设置：稳定 HTTPS PUBLIC_BASE_URL、持久目录、静态目录和加密密钥。
# 不要直接把本地示例中的 localhost 回调/FRONTEND_URL/MELODYPATH_BIND 复制到生产。
MELODYPATH_DATA_DIR=
MELODYPATH_STATIC_DIR=
# 仅生产：32 随机字节的标准 Base64；不可丢失或直接替换，否则原 OAuth 会话无法解密。
OAUTH_TOKEN_ENCRYPTION_KEY=
# 生产可由平台注入 PORT；未显式 MELODYPATH_BIND 时绑定 0.0.0.0:PORT。

# 可选：OpenAI-compatible LLM。Key 只能通过环境变量提供。
OPENAI_API_KEY=

# 可选：Spotify 真实写入。回调地址需同时登记在 Spotify Developer Dashboard。
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:3000/api/spotify/callback
SPOTIFY_MARKET=US
FRONTEND_URL=http://127.0.0.1:5173

# Google OAuth + YouTube Data API v3（必须在 Google Cloud Console 登记完全一致的回调地址）
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:3000/api/youtube/callback
# 可选：仅用于授权前的 API Key 检查；官方 OAuth、搜索和时长读取使用 Bearer token。
YOUTUBE_API_KEY=

# Apple Music / MusicKit on the Web。私钥只放本机安全路径，绝不能提交。
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY_PATH=
APPLE_MUSIC_DEVELOPER_TOKEN=
APPLE_MUSIC_STOREFRONT=cn

# 无需账号的本地歌单分析：Apple 公开目录 storefront，默认 CN。
ITUNES_STOREFRONT=CN
# 可选：真实相似歌曲推荐。只需要 API Key，不要求终端用户登录 Last.fm。
# 未配置时页面会明确显示推荐服务未配置，且不会回退 Apple 关键词搜索或 Demo。
LASTFM_API_KEY=
# 为避免一次分析等待过久，最多联网补全前 40 首；其余使用本地知识库与基础统计。
LOCAL_ANALYSIS_MAX_TRACKS=40
# Optional production-only course demo notice; set YYYY-MM-DD at deployment.
PUBLIC_DEMO_EXPIRES_AT=
